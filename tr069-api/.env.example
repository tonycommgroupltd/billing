PORT=3002

# GenieACS NBI (Northbound Interface)
GENIEACS_NBI_URL=

# TonyComm billing DB (read-only customer lookup by PPPoE / mikrotik_name)
REMOTE_DB_HOST=
REMOTE_DB_PORT=3306
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=
REMOTE_DB_NAME=

# Auth: admin JWT (same secret as Laravel) and/or static API key
JWT_SECRET=
TR069_API_KEY=

# CORS (comma-separated origins)
CORS_ORIGINS=http:

# SmartOLT (read-only — customer connectivity header)
SMARTOLT_BASE_URL=
SMARTOLT_READ_API_KEY=
SMARTOLT_CACHE_TTL_MS=2700000
