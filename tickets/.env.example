REACT_APP_API_URL=/api
# Dev API routing (setupProxy.js):
# false = proxy /api to VPS tickets-api at REACT_APP_VPS_PROXY_TARGET (HTTP + Host header)
# true  = use local PHP (npm run api) — needs api/config.local.php with remote MySQL host
REACT_APP_PHP_USE_LOCAL=false
REACT_APP_PHP_API_LOCAL=http://127.0.0.1:8080
REACT_APP_VPS_PROXY_TARGET=https://your-isp-host.example
REACT_APP_VPS_PROXY_HOST=your-isp-host.example
REACT_APP_NODE_API_URL=http://127.0.0.1:3500/api
REACT_APP_NODE_API_KEY=YOUR_NODE_API_KEY
REACT_APP_SOCKET_URL=
REACT_APP_JWT_SECRET=
REACT_APP_SIGN_UP=false
GENERATE_SOURCEMAP=false
REACT_APP_SITE_TITLE=TCOM Ticketing
REACT_APP_ENABLE_TECHNICIAN_ASSISTANT=true
