PORT=3003

# Faiba 2 RouterOS API
ROUTEROS_HOST=10.88.0.5
ROUTEROS_PORT=8728
ROUTEROS_USER=api
ROUTEROS_PASSWORD=
ROUTEROS_TIMEOUT=60

# Auth (same JWT as Laravel admin)
JWT_SECRET=

# Cache SNMP poll results (ms) — poll mode only
OLT_CACHE_TTL_MS=120000
OLT_REQUIRE_PING=false

# SNMP trap receiver (push mode — HIOSO switch OLT)
SNMP_TRAP_ENABLED=true
SNMP_TRAP_PORT=3162
SNMP_TRAP_BIND=0.0.0.0
TRAP_ONLINE_WINDOW_MS=900000
FAIBA_MGMT_IP=192.168.0.1
HIOSO_MGMT_IP=192.168.0.88
FAIBA_MGMT_PORT=ether13
ROUTEROS_USE_PHP=true
ROUTEROS_PHP_BIN=php
FAIBA_TRAP_IP=192.168.0.1
SNMP_TRAP_PORT=3162

CORS_ORIGINS=https://app.tonycommgroupltd.com,https://isp.tonycommgroupltd.com,http://localhost:3001
