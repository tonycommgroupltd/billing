APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# AI Buddy — full-app read-only assistant with allowlisted tools
# (customers, tickets, SMS, billing, RADIUS, logs, hotspot, routers)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=60

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_DUMP_BINARY_PATH=

# Remote TonyComm billing DB (read-only) — same host as tonycomm if co-located
# TICKETS_DB_HOST=127.0.0.1
# TICKETS_DB_PORT=3306
# TICKETS_DB_DATABASE=tonycommgroupltd_db
# TICKETS_DB_USERNAME=
# TICKETS_DB_PASSWORD=

# Mwananchi + TPay/Heshima hotspot (merged in APP.TCOM Hotspot menu)
HOTSPOT_ENABLED=true
HOTSPOT_API_URL=https://mwananchi.tcom.co.ke/integration/v1/index.php
HOTSPOT_CLIENT_ID=app-tcom
HOTSPOT_API_SECRET=
HOTSPOT_ADVANCED_URL=https://mwananchi.tcom.co.ke/admin/
HOTSPOT_CONNECT_TIMEOUT=10
HOTSPOT_TIMEOUT=45
HOTSPOT_TPAY_ENABLED=true
HOTSPOT_TPAY_API_URL=https://tpay.co.ke/hotspot/integration/v1/index.php
HOTSPOT_TPAY_API_SECRET=
HOTSPOT_TPAY_ADVANCED_URL=https://tpay.co.ke/hotspot/admin/

# WireGuard hub SSH (set on VPS only — used by /admin/networking/VPN sync)
VPN_LOCAL_SSH_USER=joram
VPN_LOCAL_SSH_PASSWORD=
VPN_CLOUD_SSH_USER=root
VPN_CLOUD_SSH_PASSWORD=

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

#node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

SMS_API_KEY=
SMS_PARTNER_ID=
SMS_SHORTCODE=

DOCUMENT_PUBLIC_URL=https://isp.tonycommgroupltd.com
DOCUMENT_SHARE_DAYS=30
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_COMPANY_EMAIL=tonycommgroupltd@gmail.com
DOCUMENT_COMPANY_WEBSITE=www.tonycommgroupltd.com
DOCUMENT_COMPANY_ADDRESS="P.O. Box 441-20100, Nakuru, Kenya"
DOCUMENT_LOGO_PATH=assets/images/tonycomm-logo.png

APP_TIMEZONE=

WHATSAPP_ACCESS_TOKEN=
FROM_PHONE_NUMBER_ID=
WHATSAPP_API_URI=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_SEPARATOR=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SIGNATURE_VERIFY=

SERVER_MONITOR_NEXT_RUN_IN_MINUTES=
