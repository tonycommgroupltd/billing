# Copy to .env (never commit)
PORT=3501

# Billing DB (read-only) — migrated VPS
REMOTE_DB_HOST=YOUR_VPS_IP
REMOTE_DB_PORT=3306
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=
REMOTE_DB_NAME=

# Local cache (ONU / ACS sync)
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=

API_KEY=
REACT_APP_NODE_API_KEY=YOUR_NODE_API_KEY

# SmartOLT (staff Wi‑Fi read/write)
SMARTOLT_BASE_URL=
SMARTOLT_API_KEY=
SMARTOLT_READ_API_KEY=
SMARTOLT_WRITE_API_KEY=
