{
  "name": "isp-app",
  "homepage": "https://app.tonycommgroupltd.com",
  "version": "0.2.5",
  "private": true,
  "main": "electron/main.js",
  "description": "Tonycomm ISP Admin desktop app",
  "author": "Tonycomm Group LTD",
  "dependencies": {
    "@fluentui/react-components": "^9.46.7",
