  "scripts": {
    "start": "set NODE_OPTIONS=--openssl-legacy-provider&& set PORT=3001&& react-scripts start",
    "build": "react-scripts build",
    "build:cpanel": "set NODE_OPTIONS=--openssl-legacy-provider --max-old-space-size=2560&& set GENERATE_SOURCEMAP=false&& npx --yes env-cmd -f .env.cpanel react-scripts build",
    "build:cpanel:production": "set NODE_OPTIONS=--openssl-legacy-provider --max-old-space-size=2560&& set GENERATE_SOURCEMAP=false&& npx --yes env-cmd -f .env.cpanel.production react-scripts build",
    "build:acs": "set NODE_OPTIONS=--openssl-legacy-provider --max-old-space-size=2560&& set GENERATE_SOURCEMAP=false&& set PUBLIC_URL=/&& npx --yes env-cmd -f .env.acs react-scripts build",
    "build:desktop": "set NODE_OPTIONS=--openssl-legacy-provider&& set PUBLIC_URL=/&& npx --yes env-cmd -f .env.desktop react-scripts build",
    "electron:dev": "set ELECTRON_START_URL=http://127.0.0.1:3001&& electron .",
    "electron:preview": "set ELECTRON_USE_BUILD=1&& electron .",
    "electron:build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& npm run build:desktop && electron-builder --win nsis",
    "electron:build:dir": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& npm run build:desktop && electron-builder --win dir",
    "electron:icons": "node electron/scripts/make-icons.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "build": {
    "extends": null,
    "appId": "com.tonycomm.isp-admin",
    "productName": "Tonycomm ISP Admin",
    "icon": "electron/resources/icon.ico",
    "directories": {
      "output": "release-desktop",
      "buildResources": "electron/resources"
    },
    "files": [
      "!**/*",
      "build/**/*",
      "electron/**/*",
      "!electron/node_modules/**/*",
      "!electron/package-lock.json",
      "!electron/scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/node_modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "afterPack": "./electron/scripts/afterPack.js",
    "win": {
      "icon": "electron/resources/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tonycomm ISP Admin",
      "installerIcon": "electron/resources/icon.ico",
      "uninstallerIcon": "electron/resources/icon.ico",
      "installerHeaderIcon": "electron/resources/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://isp.tonycommgroupltd.com/desktop/"
      }
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "concurrently": "^9.2.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "env-cmd": "^10.1.0",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.3",
    "wait-on": "^8.0.5"
  }
}
