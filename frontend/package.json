    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "export-from-json": "^1.7.0",
    "express": "^4.22.2",
    "focus-formik-error": "^1.1.0",
    "formik": "^2.2.9",
    "gemoji": "^8.1.0",
    "html-react-parser": "^1.4.14",
    "html2canvas": "^1.4.1",
    "http-proxy-middleware": "^2.0.10",
    "jquery": "^3.7.1",
    "jsonwebtoken": "^8.5.1",
    "jspdf": "^2.5.2",
    "jwt-decode": "^4.0.0",
    "luxon": "^2.1.1",
    "moment": "^2.30.1",
    "nouislider-react": "^3.4.1",
    "pretty-bytes": "^6.1.1",
    "react": "^17.0.2",
    "react-beautiful-dnd": "^13.1.1",
    "react-bootstrap-daterangepicker": "^8.0.0",
    "react-chartjs-2": "^4.0.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-data-table-component": "^7.5.3",
    "react-datepicker": "^4.8.0",
    "react-dom": "^17.0.2",
    "react-dropzone": "^11.7.1",
    "react-dual-listbox": "^2.3.0",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^6.15.8",
