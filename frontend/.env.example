# --- Local dev (npm start) — use proxy paths; see src/setupProxy.js ---
# REACT_APP_API_URL=/production-api/v1
# REACT_APP_API_URL_FALLBACK=/standby-api/v1
# REACT_APP_TR069_API_URL=/tr069-api
# REACT_APP_OLT_API_URL=/olt-api
# REACT_APP_VPN_API_URL=/standby-vpn-api
# REACT_APP_TICKETS_API_URL=/tickets-api
# REACT_APP_SKIP_TICKETS_AUTH_SYNC=false

# --- Production build / deployed app — direct URLs ---
REACT_APP_API_URL=https://isp.tonycommgroupltd.com/api/v1
REACT_APP_API_URL_FALLBACK=https://acs.tcom.co.ke/api/v1
REACT_APP_SOCKET_URL=https://isp.tonycommgroupltd.com
REACT_APP_SIGN_UP=false
GENERATE_SOURCEMAP=false
REACT_APP_SITE_TITLE=Tonycomm Group LTD
REACT_APP_TR069_API_URL=https://isp.tonycommgroupltd.com/tr069-api
REACT_APP_OLT_API_URL=https://isp.tonycommgroupltd.com/olt-api
# VPN API runs on standby hub only (WireGuard hub 102.0.15.254 — not on VPS 100)
REACT_APP_VPN_API_URL=http://102.0.15.254/vpn-api
# Tickets API:
# - Hosted on isp.tonycommgroupltd.com (Apache ProxyPass): /tickets-api
# - Hosted on app.tonycommgroupltd.com (cPanel SPA only): use Contabo absolute URL
#   REACT_APP_TICKETS_API_URL=https://isp.tonycommgroupltd.com/tickets-api
#   (Do NOT use tickets.tonycommgroupltd.com from the browser — bot protection.)
# - Dev/Electron: /tickets-api via setupProxy / electron gateway
REACT_APP_TICKETS_API_URL=https://isp.tonycommgroupltd.com/tickets-api
REACT_APP_SKIP_TICKETS_AUTH_SYNC=false
# cPanel build: npm run build:cpanel  (uses .env.cpanel)

# Local backend instead (Option local):
# REACT_APP_API_URL=http://127.0.0.1:8000/api/v1
# REACT_APP_SOCKET_URL=http://localhost:3000
